/CLEAR
/TITLE,NRC legacy piping model for ANSYS 11 provenance demo
/PREP7

! Legacy element technology.
ET,1,PIPE16
ET,2,PIPE18
ET,3,MASS21
KEYOPT,3,3,2

! Pipe real constants: OD, wall thickness; bend also uses radius.
R,1,7.288,0.241,0,0,0,0
R,2,7.288,0.241,36.30,0,0,0

! Benchmark nodes.
N,1,0,0,0
N,2,0,54.45,0
